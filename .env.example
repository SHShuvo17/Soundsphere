# SoundSphere Environment Configuration
SECRET_KEY=soundsphere-super-secure-production-key-change-in-prod-2026!
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL)
# If DB_NAME is set and Postgres is reachable, Django uses PostgreSQL.
# Otherwise, it falls back seamlessly to db.sqlite3 for zero-config local runs.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=soundsphere_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Fallback switch: set to 1 or true to force SQLite
USE_SQLITE=True
